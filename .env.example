# Copy this file to .env for local Docker runs.
# Never commit the real .env file.

APP_DOMAIN=localhost

# SQL Server requires a strong password.
MSSQL_SA_PASSWORD=Change_this_local_password_123!

JWT_ISSUER=Back
JWT_AUDIENCE=Back.Client

# Use a long random value in real environments.
# Example PowerShell generator:
# [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET_KEY=replace-with-a-long-random-secret
