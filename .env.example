# Copy this file to .env for local Docker runs.
# Never commit the real .env file.

APP_DOMAIN=localhost

POSTGRES_DB=back_order_management
POSTGRES_USER=back_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password

JWT_ISSUER=Back
JWT_AUDIENCE=Back.Client

# Use a long random value in real environments.
# Generate a JWT secret in PowerShell:
# $bytes = New-Object byte[] 64
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($bytes)
# [Convert]::ToBase64String($bytes)
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Keeps public demo users in read-only mode.
DEMO_READ_ONLY_MODE=true
